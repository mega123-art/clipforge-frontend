# Google OAuth Web Client ID — same value as backend GOOGLE_CLIENT_ID
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Required for the Google Sign-In button on /signin and /signup
VITE_GOOGLE_CLIENT_ID=123456789-abcxyz.apps.googleusercontent.com

# development = auto-login as dev@localhost, skip sign-in page
# production  = normal auth required
VITE_APP_ENV=development
